# ============================================================================
# Bitácora — variables de entorno de Netlify
# Copia este archivo a .env (NO subas .env a git) y rellena los valores,
# pero las credenciales reales deben ir en el panel de Netlify:
#   Site settings > Environment variables
# ============================================================================

# URL del proyecto de Supabase (Dashboard > Settings > API > Project URL)
SUPABASE_URL=https://rjmftwujvusprlbxtbbg.supabase.co

# Clave pública "anon" (Dashboard > Settings > API > Project API keys > anon public)
# Esta va también en supabase.config.js (es pública por diseño)
SUPABASE_ANON_KEY=tu_anon_key_publica

# Clave "service_role" (Dashboard > Settings > API > Project API keys > service_role)
# IMPORTANTE: secreto. SOLO en el panel de Netlify, nunca en el repo ni en el chat.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_secreta
